# MemPalace memory server, containerised for docker-mode daedalus.
#
# MemPalace's own MCP server is STDIO-ONLY (no HTTP transport — see
# github.com/MemPalace/mempalace). To make it reachable by other containers on the
# daedalus network we front it with `mcp-proxy` (sparfenyuk/mcp-proxy), a
# stdio→HTTP/SSE bridge. The proxy listens on :11364 and spawns the stdio mempalace
# server, passing through the palace directory.
#
# Everything runs via uv/uvx (no pip): the base image ships `uv`, and both
# mcp-proxy and mempalace are run with `uvx` (resolved once, then cached in the
# image layer by the pre-warm below).
#
# The palace (mempalace's on-disk store: chroma + knowledge graph) lives at /palace.
# Bind-mount a host directory there so the data persists and the container stays
# stateless:  -v /home/you/.daedalus/mempalace:/palace
#
# Build:  docker build -f Dockerfile.mempalace -t ghcr.io/inline-studio/mempalace-mcp:latest .
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Where the palace is mounted. Override at runtime if you mount elsewhere.
ENV MEMPALACE_PALACE=/palace
EXPOSE 11364

# Pre-warm uv's cache at build time so the daemon starts without a cold download
# (mempalace pulls chromadb + onnxruntime, so this is a chunky but one-time layer).
RUN uvx mcp-proxy --help >/dev/null 2>&1 || true \
 && uvx --from mempalace python -c "import mempalace" >/dev/null 2>&1 || true

# mcp-proxy serves SSE at /sse (its default) and bridges to the stdio mempalace
# module. `exec` so signals reach the proxy. Palace path comes from the env so a
# compose/`docker run` can point it at the bind-mounted host dir.
ENTRYPOINT ["sh", "-c", "exec uvx mcp-proxy --host 0.0.0.0 --port 11364 -- uvx --from mempalace python -m mempalace.mcp_server --palace \"$MEMPALACE_PALACE\""]
