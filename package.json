{
  "name": "daedalus",
  "version": "0.1.0",
  "description": "SDK-agnostic agent runner with brain-repo-driven personas, skills, MCP, scheduling, and per-agent containers. CLI: `dae`.",
  "private": true,
  "type": "module",
  "bin": {
    "dae": "./dist/index.js",
    "daedalus": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "node scripts/test.mjs",
    "link:cli": "npm run build && npm link",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "croner": "^9.0.0",
    "dotenv": "^16.4.5",
    "execa": "^9.5.1",
    "gray-matter": "^4.0.3",
    "node-html-parser": "^6.1.13",
    "openai": "^5.0.0",
    "pino": "^9.5.0",
    "prompts": "^2.4.2",
    "turndown": "^7.2.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.1.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/prompts": "^2.4.9",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
